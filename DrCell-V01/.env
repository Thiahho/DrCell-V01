# DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=drcelldb

# CONNECTION
DefaultConnection=Host=localhost;Port=5432;Database=drcelldb;Username=postgres;Password=123456

# ASP.NET
# ASPNETCORE_ENVIRONMENT=Production

# JWT
JWT__Secret=DrCell_SuperSecretKey_2024_!@#$%^&*()_+_MinLength_32_Characters
JWT__ValidIssuer=https://api.drcell.com
JWT__ValidAudience=https://drcell.com
JWT__TokenExpiryTimeInHour=1
JWT__RefreshTokenExpiryTimeInDays=7

# CORS
CORS__AllowedOrigins=http://localhost:3000,https://drcell.com.ar,http://drcell.com.ar
